{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "class.schema.json",
  "title": "Classes",
  "description": "Map of class name -> class definition (migrated from classes.json). Per-level progression for the builder's math.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "keyAbility", "resource", "progression"],
    "properties": {
      "type": { "enum": ["magic", "martial"] },
      "keyAbility": { "type": "string" },
      "resource": { "enum": ["PM", "Chi", "none", null], "description": "Casting resource pool, or null for classes with none." },
      "progression": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "prof"],
          "properties": {
            "level": { "type": "integer", "minimum": 1, "maximum": 20 },
            "prof": { "type": "integer" },
            "magicTalents": { "type": "integer" },
            "martialTalents": { "type": "integer" },
            "pm": { "type": "integer" },
            "chi": { "type": "integer" }
          }
        }
      }
    }
  }
}
